root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,yml,yaml,toml,json}]
indent_size = 2

# A version catalog's coordinate lines cannot wrap; the 100-column rule is for
# code, not for dependency declarations.
[*.toml]
max_line_length = off

[*.md]
trim_trailing_whitespace = false

[{justfile,Justfile,*.just}]
indent_style = space
indent_size = 4

[Containerfile]
indent_size = 2

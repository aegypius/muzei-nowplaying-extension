# Copy to keystore.properties and fill in. Never commit the result.
#
# Obtainium installs updates in place only while the signature is unchanged, so
# this key must stay the same for the life of the app. Back it up somewhere other
# than this machine: losing it means uninstalling and reinstalling by hand.
#
# Generate one with:
#   keytool -genkeypair -v -keystore nowplaying.jks -alias nowplaying \
#           -keyalg RSA -keysize 4096 -validity 10000

store=/path/to/nowplaying.jks
alias=nowplaying
storePass=your_keystore_password
pass=your_key_password

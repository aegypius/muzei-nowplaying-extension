# Copy to keystore.properties and fill in. Never commit the result: .gitignore
# excludes it and a pre-commit hook refuses it.
#
# This file holds only the secrets. The keystore's location is not configured here
# -- the justfile bind-mounts it into the build container from
# ~/.config/nowplaying/release.jks, overridable with NOWPLAYING_KEYSTORE.
#
# Create the key with:
#   just keystore
#
# There is deliberately no separate key password. keytool produces a PKCS12
# keystore, which does not support one: given a distinct -keypass it warns
# "Different store and key passwords not supported for PKCS12 KeyStores" and
# ignores it. The store password protects both.
#
# Obtainium installs updates in place only while the signature is unchanged, so
# this key must stay the same for the life of the app. Back the file up somewhere
# other than this machine: losing it means uninstalling and reinstalling by hand.

alias=nowplaying
storePass=your_keystore_password

<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <!-- The key is read by ConnectionPublishGate; changing it silently resets the
       user's choice to the default. -->
  <SwitchPreferenceCompat
    android:defaultValue="false"
    android:key="unmetered_only"
    android:summaryOff="@string/settings_unmetered_summary_off"
    android:summaryOn="@string/settings_unmetered_summary_on"
    android:title="@string/settings_unmetered_title"
    app:iconSpaceReserved="false" />

  <!-- The entries are built in code from the players seen playing, so this names
       the fragment rather than nesting a screen: there is nothing to declare here
       until something has played. -->
  <Preference
    android:fragment="com.aegypius.muzei.nowplaying.BlockedPlayersFragment"
    android:key="blocked_players_screen"
    android:summary="@string/settings_players_summary"
    android:title="@string/settings_players_title"
    app:iconSpaceReserved="false" />

</PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's background layer. It must be opaque and cover the whole
     108dp canvas: the launcher may translate it while masking, and any gap would
     show through as a transparent edge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
  android:width="108dp"
  android:height="108dp"
  android:viewportWidth="108"
  android:viewportHeight="108">

  <path
    android:fillColor="@color/ic_launcher_background"
    android:pathData="M0,0 h108 v108 h-108 z" />

</vector>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The provider downloads the artwork itself: Muzei calls openFile on this
       ContentProvider, and the muzei-api default implementation opens the
       persistent URI from within this process. Muzei does not fetch it. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Required to ask ConnectivityManager whether the connection is metered.
       Without it getNetworkCapabilities throws SecurityException, which would kill
       the process on every publish. The predecessor declared it too. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <application
    android:label="@string/app_name"
    android:theme="@style/Theme.NowPlaying">

    <!-- Muzei discovers art providers through the manifest; there is no
         registration call. The permission restricts access to Muzei, and the
         intent-filter action is what makes it discoverable at all. The authority
         is not duplicated in code: MuzeiArtProvider reads it from here.

         setupActivity is launched by Muzei before it enables the provider, and
         Muzei acts on the result code: a provider that cannot see media sessions
         should not be enabled. settingsActivity is opened from Muzei's provider
         list, and its result is not read. -->
    <provider
      android:name=".NowPlayingArtProvider"
      android:authorities="com.aegypius.muzei.nowplaying"
      android:description="@string/provider_description"
      android:exported="true"
      android:label="@string/provider_label"
      android:permission="com.google.android.apps.muzei.api.ACCESS_PROVIDER">
      <intent-filter>
        <action android:name="com.google.android.apps.muzei.api.MuzeiArtProvider" />
      </intent-filter>

      <meta-data
        android:name="setupActivity"
        android:value="com.aegypius.muzei.nowplaying.SetupActivity" />

      <meta-data
        android:name="settingsActivity"
        android:value="com.aegypius.muzei.nowplaying.SettingsActivity" />
    </provider>

    <!-- Launched by Muzei, so it must be exported. It holds nothing sensitive: it
         reads whether access is granted and deep-links to the system page. -->
    <activity
      android:name=".SetupActivity"
      android:exported="true"
      android:label="@string/app_name" />

    <!-- Exported because Muzei opens it from its provider list. It takes no extras
         and returns no result, so there is nothing for a caller to influence. -->
    <activity
      android:name=".SettingsActivity"
      android:exported="true"
      android:label="@string/settings_title" />

    <!-- The only route to media sessions: MediaSessionManager.getActiveSessions
         requires notification-listener access, which Android grants solely through
         system settings. Exported because the system binds it from another
         process; the BIND permission is what restricts who may. -->
    <service
      android:name=".NowPlayingListenerService"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>

      <!-- Declines every notification type, so this listener is never delivered a
           notification at all. Only media sessions are wanted, and those come from
           MediaSessionManager rather than from notification delivery.

           The grant screen's warning text is fixed by Android and will still say
           this app can read notifications, reply to messages and change settings:
           BIND_NOTIFICATION_LISTENER_SERVICE is all-or-nothing and the wording is
           generic to the permission, not derived from what an app uses. This
           narrows the actual capability, not the warning.

           Confirmed on hardware: media sessions are still detected with every
           notification type declined, because the gate is being an enabled
           listener rather than receiving notifications. -->
      <meta-data
        android:name="android.service.notification.disabled_filter_types"
        android:value="conversations|alerting|silent|ongoing" />
    </service>

  </application>

</manifest>

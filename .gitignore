# Upstream clones kept beside this project as read-only reference.
# See AGENTS.md — read them, never paste from them, never commit them.
#
# The leading slash is essential. Unanchored, `muzei/` matches a directory of
# that name at ANY depth, which silently excluded the entire source tree --
# the package is com.aegypius.muzei.nowplaying, so every file lives under a
# directory called `muzei`.
/muzei/
/MuzeiMusicExtension/

# Signing. The release key must never be committed; see keystore.properties.example.
keystore.properties
*.jks
*.keystore

# Served builds. Every build lands here signed, so this fills up fast.
dist/

# Local machine configuration
local.properties
.claude/settings.local.json
.parsec/

# The Gradle wrapper jar must be committed or ./gradlew cannot bootstrap itself.
# Re-included explicitly because the global gitignore excludes *.jar, which would
# otherwise drop it silently and leave a fresh clone unable to build.
!gradle/wrapper/gradle-wrapper.jar

# Gradle and Android build output
.gradle/
build/
*.apk
*.aab
*.ap_
*.dex

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
